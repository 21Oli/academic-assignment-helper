# ============================================================
# Academic Assignment Helper — Environment Variables Template
#
# INSTRUCTIONS:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in your real values in .env
#   3. Never commit .env — it is git-ignored
# ============================================================

# ------------------------------------------------------------
# PostgreSQL
# ------------------------------------------------------------
POSTGRES_DB=academic_helper
POSTGRES_USER=student
POSTGRES_PASSWORD=change_me_strong_password

# ------------------------------------------------------------
# LLM / Embedding Provider
#
# OPTION A — NVIDIA NIM (free tier available at build.nvidia.com)
# ------------------------------------------------------------
LLM_API_KEY=nvapi-REPLACE_WITH_YOUR_NVIDIA_KEY
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
EMBEDDING_MODEL=nvidia/nv-embedqa-e5-v5
OPENAI_COMPLETION_MODEL=meta/llama-3.3-70b-instruct
EMBEDDING_DIM=1024

# ------------------------------------------------------------
# OPTION B — OpenAI
# Uncomment these and comment out Option A above
# ------------------------------------------------------------
# LLM_API_KEY=sk-REPLACE_WITH_YOUR_OPENAI_KEY
# LLM_BASE_URL=https://api.openai.com/v1
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_COMPLETION_MODEL=gpt-4o-mini
# EMBEDDING_DIM=1536

# ------------------------------------------------------------
# Auth — generate a strong random secret (min 32 chars)
# Python: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------
JWT_SECRET_KEY=replace_with_a_long_random_secret_min_32_chars

# ------------------------------------------------------------
# n8n webhook (internal Docker network — do not change unless
# you rename the n8n service in docker-compose.yml)
# ------------------------------------------------------------
N8N_WEBHOOK_URL=http://n8n:5678/webhook/assignment

# ------------------------------------------------------------
# RAG tuning
# ------------------------------------------------------------
RAG_CHUNK_SIZE=2000
RAG_MAX_CHUNKS=5
PLAGIARISM_THRESHOLD=0.85

# ------------------------------------------------------------
# Logging & CORS
# LOG_LEVEL: DEBUG | INFO | WARNING | ERROR
# CORS_ORIGINS: comma-separated list of allowed frontend origins
# ------------------------------------------------------------
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------
# Docker build
# Set to "true" to include sentence-transformers + torch (~2 GB)
# for offline local embedding fallback. Not needed with NVIDIA/OpenAI.
# ------------------------------------------------------------
ENABLE_LOCAL_EMBEDDINGS=false
